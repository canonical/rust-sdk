{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "custom.regex"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^VERSION$/"
      ],
      "matchStrings": [
        "(?<currentValue>[0-9.]+)"
      ],
      "depNameTemplate": "rust-lang/rustup",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^sdkcraft\\.yaml$/"
      ],
      "matchStrings": [
        "source-tag:\\s*\"(?<currentValue>[0-9.]+)\""
      ],
      "depNameTemplate": "rust-lang/rustup",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver"
    }
  ],
  "baseBranchPatterns": [
    "1"
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "rust-lang/rustup"
      ],
      "matchBaseBranches": [
        "1"
      ],
      "allowedVersions": "/^1\\./"
    }
  ]
}
